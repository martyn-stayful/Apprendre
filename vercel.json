{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/uploads/parse.js": { "maxDuration": 300 },
    "api/**/*.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}

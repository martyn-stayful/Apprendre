# --- Neon Postgres -------------------------------------------------------
# Vercel's Neon integration sets this for you. Locally, copy the pooled
# connection string from the Neon dashboard (the one with "-pooler" in it).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# --- Anthropic -----------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Auth ----------------------------------------------------------------
# Secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Leave unset to let anyone sign up. Set it to require an invite code,
# so strangers can't create accounts and spend your Claude credits.
SIGNUP_CODE=""

# --- Vercel Blob (file uploads) -----------------------------------------
# Created automatically when you add Blob storage to the project on Vercel.
# Without it, photo/PDF uploads are held in memory for the parse only and the
# original file is not retained.
BLOB_READ_WRITE_TOKEN=""
